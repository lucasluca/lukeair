<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:tint="#FF38BDF8"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/open_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.18"
                    android:text="RESFRIANDO"
                    android:textColor="#FF38BDF8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:text="23°"
                    android:textColor="#FFF1F5F9"
                    android:textSize="46sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_power"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Ligar ou desligar">

                <ImageView
                    android:id="@+id/power_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_circle"
                    android:tint="#FF38BDF8"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/power_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_power"
                    android:tint="#FF0B1020"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/btn_minus" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn"
                android:contentDescription="Diminuir temperatura">
                <ImageView android:id="@+id/minus_icon" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_minus" android:tint="#FF38BDF8" android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout android:id="@+id/btn_plus" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn"
                android:contentDescription="Aumentar temperatura">
                <ImageView android:id="@+id/plus_icon" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_plus" android:tint="#FF38BDF8" android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout android:id="@+id/btn_mode" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/widget_btn"
                android:contentDescription="Trocar modo">
                <ImageView android:id="@+id/mode_icon" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_snow" android:tint="#FF38BDF8" android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout android:id="@+id/btn_display" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/widget_btn"
                android:contentDescription="Display">
                <ImageView android:id="@+id/display_icon" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_display" android:tint="#FF38BDF8" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
